{
  "name": "plateapp",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "eslint . --fix",
    "generate-colors": "node ./scripts/generate-colors.js && eslint ./constants/colors.ts --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "detox test",
    "type-check": "tsc --noEmit",
    "build:apk": "eas build --platform android --profile apk",
    "build:apk:local": "eas build --platform android --profile apk --local",
    "build:android:preview": "eas build --platform android --profile preview",
    "build:production": "eas build --platform all --profile production",
    "builds:status": "node scripts/check-builds.js",
    "builds:list": "eas build:list",
    "supabase:start": "npx supabase start",
    "supabase:stop": "npx supabase stop",
    "supabase:status": "npx supabase status",
    "supabase:reset": "npx supabase db reset",
    "supabase:migrate": "npx supabase db push",
    "supabase:pull": "npx supabase db pull",
    "supabase:diff": "npx supabase db diff",
    "supabase:gen-types": "npx supabase gen types typescript --local > types/supabase-local.ts",
    "supabase:functions:serve": "npx supabase functions serve",
    "supabase:functions:deploy": "npx supabase functions deploy"
  },
